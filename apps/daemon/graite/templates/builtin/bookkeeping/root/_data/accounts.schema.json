      "options": [
        "Bank",
        "Savings",
        "Cash",
        "Credit card"
      ],
      "colors": {
        "Bank": "blue",
        "Savings": "green",
        "Cash": "yellow",
        "Credit card": "purple"
      }
    },
    "opening_balance": {
      "type": "currency",
